# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# OpenWeather API
OPENWEATHER_API_KEY=your_api_key_here

# Postgres credentials (used by Docker Compose to init containers and build internal URLs)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_TEST_USER=user
POSTGRES_TEST_PASSWORD=pass

# Used by local dev (uv run uvicorn / pytest) — must match credentials above
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/weather
DATABASE_TEST_URL=postgresql+asyncpg://user:pass@localhost:5433/weather_test

# Redis
REDIS_URL=redis://localhost:6379/0

# App
LOG_LEVEL=INFO
